---
import { Image } from 'astro:assets';
import aboutImg from '../assets/photos/about.jpg';
import { bioFacts, consultGoals } from '../data/master';
---

<section id="about">
  <div class="wrap grid">
    <figure class="photo" data-reveal>
      <Image
        src={aboutImg}
        alt="Мария Микова, психолог"
        widths={[480, 720, 960]}
        sizes="(max-width: 860px) 440px, 460px"
        format="webp"
        quality={88}
        loading="lazy"
        class="photo-img"
      />
    </figure>

    <div class="copy" data-reveal data-reveal-delay="140">
      <span class="section-eyebrow">Обо мне</span>
      <h2>
        Мария Микова, <em>практикующий психолог</em>
        с&nbsp;опытом преподавания в&nbsp;вузе.
      </h2>

      <p class="lead">
        Образование высшее профессиональное: специалитет, магистратура,
        аспирантура. Опыт работы более 9&nbsp;лет. 7&nbsp;лет преподавала
        в&nbsp;Алтайском государственном педагогическом университете
        на&nbsp;факультете психологии и&nbsp;педагогики.
      </p>

      <p>На нашей консультации мы:</p>
      <ul class="goals">
        {consultGoals.map((g) => <li set:html={g} />)}
      </ul>
      <p class="note">Конфиденциальность гарантирую.</p>

      <dl class="facts">
        {bioFacts.map((f) => (
          <div>
            <dt>{f.value}</dt>
            <dd>{f.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .photo {
    margin: 0;
  }
  .photo-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    display: block;
  }
  h2 {
    margin-bottom: 28px;
  }
  h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .lead {
    font-size: 18px;
    color: var(--ink);
    margin-bottom: 18px;
    line-height: 1.6;
  }
  .copy p {
    color: var(--ink-muted);
    margin-bottom: 18px;
    font-size: 17px;
    line-height: 1.65;
  }
  .copy p strong {
    color: var(--ink);
    font-weight: 500;
  }


  .goals {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: grid;
    gap: 8px;
  }
  .goals li {
    position: relative;
    padding-left: 26px;
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--ink);
  }
  .goals li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent);
    font-weight: 600;
  }
  .copy .note {
    font-size: 14px;
    color: var(--ink-soft);
    margin-bottom: 0;
  }
  .facts {
    margin: 36px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .facts dt {
    font-family: var(--font-serif);
    font-size: 26px;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.05;
  }
  .facts dd {
    margin: 0;
    font-size: 13px;
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .photo {
      max-width: 440px;
      width: 100%;
      margin: 0 auto;
    }
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
