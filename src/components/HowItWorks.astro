---
import { workNotes } from '../data/master';
import CtaGroup from './CtaGroup.astro';
---

<section id="how">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Немного о&nbsp;моей работе</span>
      <h2>Как проходят встречи и&nbsp;чего ждать от&nbsp;работы.</h2>
    </header>

    <ol class="steps">
      {workNotes.map((s, i) => (
        <li data-reveal data-reveal-delay={i * 120}>
          <span class="n">{s.n}</span>
          <h3>{s.title}</h3>
          <p set:html={s.text} />
        </li>
      ))}
    </ol>

    <div class="cta-strip">
      <p>
        Первая встреча-знакомство бесплатно.
      </p>
      <CtaGroup label="Написать в Telegram" variant="secondary" />

    </div>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 0 0 56px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .steps li {
    padding: 32px 24px 32px 0;
    position: relative;
  }
  .steps li + li {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }
  .n {
    font-family: var(--font-serif);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--accent);
    display: block;
    margin-bottom: 16px;
  }
  .steps h3 {
    margin-bottom: 10px;
    font-size: 22px;
    font-weight: 500;
  }
  .steps p {
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .cta-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0 0;
  }
  .cta-strip p {
    font-size: 17px;
  }

  @media (max-width: 1024px) and (min-width: 861px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .steps li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .steps li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .steps li + li {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .cta-strip {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
