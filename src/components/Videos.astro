---
import { master, videos } from '../data/master';
---

<section id="videos" class="vd compact">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Видео-рубрики</span>
      <h2>Короткие видео о&nbsp;психологии <em>простым языком.</em></h2>
      <p>
        Больше видео-рубрик в&nbsp;моём Telegram-канале и&nbsp;сообществе
        во&nbsp;ВКонтакте.
      </p>
    </header>

    <div class="list">
      {videos.map((v, i) => (
        <a class="item" href={v.href} target="_blank" rel="noopener" data-reveal data-reveal-delay={Math.min(i * 80, 320)}>
          <span class="play" aria-hidden="true">▶</span>
          <span class="t" set:html={v.title} />
          <span class="where">{v.where}</span>
        </a>
      ))}
    </div>

    <div class="more" data-reveal>
      <a class="btn btn-secondary" href={master.telegramChannel} target="_blank" rel="noopener">
        <span>Telegram-канал</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .vd {
    background: var(--bg-soft);
  }
  .section-head h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .item {
    display: grid;
    grid-template-columns: 46px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .item:hover {
    border-color: var(--accent-line);
    transform: translateY(-2px);
  }
  .play {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    padding-left: 3px;
  }
  .t {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.3;
  }
  .where {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .more {
    margin-top: 28px;
  }
  @media (max-width: 860px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .item {
      grid-template-columns: 40px 1fr;
    }
    .where {
      grid-column: 2;
    }
    .play {
      width: 40px;
      height: 40px;
    }
  }
</style>
